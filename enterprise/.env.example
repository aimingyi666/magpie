# =========================================================================
# Magpie Enterprise Environment Configuration (.env.example)
# =========================================================================
# Copy this file to .env and replace every "replace-with-..." value.
# All secrets must be at least 32 characters unless noted otherwise.
# Do not commit real secrets to source control.

# ---------------------------------------------------------------------------
# Core Gateway (base magpie)
# ---------------------------------------------------------------------------
MAGPIE_BIND=0.0.0.0
MAGPIE_PORT=3425
MAGPIE_ALLOW_IPS=10.0.0.0/8,192.168.0.0/16
MAGPIE_IMAGE=ghcr.io/yetone/magpie:stable
# MAGPIE_UPDATE_FEED=https://update.internal.example/magpie/feed.json

# ---------------------------------------------------------------------------
# M7 Gateway Control (IP whitelist/blacklist, quota) — port 3446
# ---------------------------------------------------------------------------
GATEWAY_CONTROL_URL=http://gateway-control:3446
GATEWAY_CONTROL_TOKEN=replace-with-a-separate-long-random-gateway-control-token
GATEWAY_CONTROL_TIMEOUT_MS=10000
GATEWAY_CONTROL_BIND=127.0.0.1
GATEWAY_CONTROL_PORT=3446
GATEWAY_CONTROL_MAGPIE=/absolute/path/to/gateway/config.json
GATEWAY_CONTROL_CONFIG_HOME=/absolute/path/to/gateway/config-home

# ---------------------------------------------------------------------------
# M6 Auth Service / OIDC SSO — port 3444
# ---------------------------------------------------------------------------
AUTH_BIND=0.0.0.0
AUTH_HOST_PORT=3444
AUTH_PUBLIC_URL=https://auth.ai.corp.example
AUTH_SECURE_COOKIE=true
AUTH_SESSION_TTL_HOURS=12
AUTH_DEVICE_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=120
AUTH_ALLOWED_RETURN_ORIGINS=
AUTH_STORE_PATH=/data/auth-store.json

# Device sync credential
SYNC_TOKEN_SECRET=replace-with-a-separate-long-random-sync-token-secret
SYNC_TOKEN_TTL_SECONDS=300
SYNC_TOKEN_AUDIENCE=magpie-enterprise-resource

# Service secrets (generate independently, never reuse)
AUTH_COOKIE_SECRET=replace-with-a-separate-long-random-cookie-secret
AUTH_ADMIN_TOKEN=replace-with-a-separate-long-random-admin-token
AUTH_INTERNAL_ADMIN_TOKEN=replace-with-a-separate-long-random-service-token
MAGPIE_ISSUER_KEY=replace-with-the-issuer-key-created-on-the-gateway

# OIDC IdP (Enterprise WeChat / DingTalk / Okta / Azure AD example)
OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
OIDC_CLIENT_ID=magpie-enterprise
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
OIDC_REDIRECT_URI=https://auth.ai.corp.example/oauth/callback
OIDC_SCOPES=openid profile email
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
OIDC_ALLOWED_EMAIL_DOMAINS=corp.example
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name
OIDC_GROUPS_CLAIM=groups

MAGPIE_GATEWAY_PUBLIC_URL=https://ai.corp.example
MAGPIE_KEY_TTL=8h
MAGPIE_KEY_MODELS=deepseek/deepseek-chat
MAGPIE_KEY_TOKENS=0
MAGPIE_KEY_COST=0

# ---------------------------------------------------------------------------
# M8 Admin Console (management portal) — port 3445
# ---------------------------------------------------------------------------
ADMIN_BIND=0.0.0.0
ADMIN_HOST_PORT=3445
ADMIN_PUBLIC_URL=https://admin.ai.corp.example
ADMIN_SECURE_COOKIE=true
ADMIN_SESSION_TTL_HOURS=8
ADMIN_IDLE_TIMEOUT_MINUTES=30
ADMIN_RATE_LIMIT_PER_MINUTE=120
ADMIN_ALLOWED_IPS=10.0.0.0/8,192.168.0.0/16
ADMIN_STORE_PATH=/data/admin-store.json

ADMIN_SESSION_SECRET=replace-with-a-separate-long-random-admin-session-secret

# Bootstrap (temporary only — remove after role bindings are seeded)
ADMIN_BOOTSTRAP_SUBJECTS=
ADMIN_BOOTSTRAP_EMAILS=platform-admin@corp.example
ADMIN_BOOTSTRAP_VALID_HOURS=24

# Dedicated management OIDC application (not the employee login app)
ADMIN_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
ADMIN_OIDC_CLIENT_ID=magpie-enterprise-admin
ADMIN_OIDC_CLIENT_SECRET=replace-with-admin-oidc-client-secret
ADMIN_OIDC_REDIRECT_URI=https://admin.ai.corp.example/admin/oauth/callback
ADMIN_OIDC_SCOPES=openid profile email
ADMIN_OIDC_TOKEN_AUTH_METHOD=client_secret_basic
ADMIN_ALLOWED_EMAIL_DOMAINS=corp.example
ADMIN_EMAIL_CLAIM=email
ADMIN_NAME_CLAIM=name
ADMIN_REQUIRE_MFA=true
ADMIN_REQUIRE_VERIFIED_EMAIL=true
ADMIN_ALLOWED_ACR_VALUES=

# Step-up authentication for high-risk / critical management writes
ADMIN_STEP_UP_OIDC_CLIENT_ID=
ADMIN_STEP_UP_OIDC_CLIENT_SECRET=
ADMIN_STEP_UP_REDIRECT_URI=https://admin.ai.corp.example/admin/oauth/step-up/callback
ADMIN_STEP_UP_OIDC_SCOPES=openid profile email
ADMIN_STEP_UP_ALLOWED_ACR_VALUES=
ADMIN_STEP_UP_TTL_SECONDS=600
ADMIN_STEP_UP_CRITICAL_TTL_SECONDS=300
ADMIN_STEP_UP_AUTH_TIME_MAX_AGE_SECONDS=120

# External approval callback (APR-01b) — leave empty to disable
ADMIN_APPROVAL_CALLBACK_SECRET=
ADMIN_APPROVAL_CALLBACK_ISSUER=
ADMIN_APPROVAL_CALLBACK_AUDIENCE=
ADMIN_APPROVAL_CALLBACK_MAX_SKEW_SECONDS=300
ADMIN_APPROVAL_CALLBACK_NONCE_TTL_SECONDS=600

# Notification outbox / channels
ADMIN_NOTIFICATION_OUTBOX_POLL_SECONDS=30
ADMIN_NOTIFICATION_ESCALATION_POLL_SECONDS=30
ADMIN_NOTIFICATION_OUTBOX_LEASE_SECONDS=60
ADMIN_NOTIFICATION_OUTBOX_MAX_ATTEMPTS=6
ADMIN_NOTIFICATION_OUTBOX_BATCH_SIZE=20
ADMIN_NOTIFICATION_CHANNELS_ENABLED=false
ADMIN_NOTIFICATION_OUTBOUND_ALLOWLIST=
ADMIN_NOTIFICATION_EMAIL_RECIPIENT_DOMAINS=
ADMIN_NOTIFICATION_HTTP_TIMEOUT_MS=5000
ADMIN_NOTIFICATION_HTTP_MAX_RESPONSE_BYTES=65536
ADMIN_NOTIFICATION_HTTP_MAX_REDIRECTS=3

# Channel secret refs (inject via secret manager — never in source control)
MAGPIE_NOTIFICATION_WEBHOOK_SECRET=
MAGPIE_NOTIFICATION_IM_TOKEN=
MAGPIE_NOTIFICATION_EMAIL_GATEWAY_TOKEN=
MAGPIE_NOTIFICATION_TICKETING_TOKEN=

# Model catalog
ADMIN_MODELS=deepseek/deepseek-chat
ADMIN_MODEL_CATALOG_DIGEST=
ADMIN_MODEL_CATALOG_PATH=/absolute/path/to/model-catalog.json
ADMIN_USAGE_PATH=/magpie-readonly/magpie/usage.jsonl
ADMIN_USAGE_MAX_BYTES=268435456
ADMIN_USAGE_MAX_LINE_BYTES=1048576
ADMIN_USAGE_MAX_RECORDS=1000000
ADMIN_USAGE_MAX_FIELDS=256
ADMIN_USAGE_MAX_RANGE_DAYS=366

# Inter-service auth token (admin-service calls auth-service)
ADMIN_AUTH_SERVICE_URL=http://auth:3444
ADMIN_AUTH_SERVICE_TOKEN=replace-with-a-separate-long-random-admin-auth-token
ADMIN_AUTH_SERVICE_TIMEOUT_MS=5000

# Resource catalog (optional)
ADMIN_RESOURCE_SERVICE_URL=
ADMIN_RESOURCE_SERVICE_TOKEN=
ADMIN_RESOURCE_SERVICE_TIMEOUT_MS=5000
ADMIN_RESOURCE_SERVICE_MAX_RESPONSE_BYTES=4194304

# Audit content service (optional)
ADMIN_AUDIT_CONTENT_SERVICE_URL=
ADMIN_AUDIT_CONTENT_SERVICE_ADMIN_TOKEN=
ADMIN_AUDIT_CONTENT_SERVICE_GOVERNANCE_TOKEN=
ADMIN_AUDIT_CONTENT_SERVICE_ORGANIZATION_ID=
ADMIN_AUDIT_CONTENT_SERVICE_EXPORT_KEY=
ADMIN_AUDIT_CONTENT_SERVICE_TIMEOUT_MS=5000
ADMIN_AUDIT_CONTENT_SERVICE_MAX_RESPONSE_BYTES=4194304
ADMIN_AUDIT_CONTENT_SERVICE_MAX_EXPORT_BYTES=33554432

# Security service (alerts / findings) — port 3450
ADMIN_SECURITY_SERVICE_URL=http://security:3450
ADMIN_SECURITY_SERVICE_TOKEN=replace-with-a-separate-long-random-security-service-token
ADMIN_SECURITY_SERVICE_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# M5 Security Service — port 3450
# ---------------------------------------------------------------------------
SECURITY_BIND=0.0.0.0
SECURITY_PORT=3450
SECURITY_INGEST_TOKEN=replace-with-a-separate-long-random-security-ingest-token
SECURITY_READ_TOKEN=replace-with-a-different-long-random-security-read-token
SECURITY_CONTROL_TOKEN=replace-with-another-separate-long-random-security-control-token
SECURITY_STORE_PATH=/data/security-store.json
SECURITY_TRUSTED_REGIONS=
SECURITY_TRUSTED_SOURCE_IP_HASHES=
SECURITY_SUPPRESSION_SECONDS=300
SECURITY_BUDGET_WARNING_RATIO=0.9
SECURITY_BUDGET_CRITICAL_RATIO=1
SECURITY_USAGE_TOKEN_MULTIPLIER=5
SECURITY_USAGE_COST_MULTIPLIER=5
SECURITY_USAGE_MINIMUM_TOKENS=100000
SECURITY_USAGE_MINIMUM_COST=10
SECURITY_RATE_LIMIT_PER_MINUTE=6000
SECURITY_MAX_BODY_BYTES=65536
SECURITY_MAX_EVENTS=1000000
SECURITY_MAX_FINDINGS=2000000
SECURITY_MAX_RESPONSE_ACTIONS=200000
SECURITY_MAX_STORE_BYTES=536870912

# Gateway-side M5-A detection exporter (leave disabled unless security profile runs)
MAGPIE_SECURITY_DETECTION_ENABLED=false
MAGPIE_SECURITY_DETECTION_URL=http://security:3450/api/v1/detection-events
MAGPIE_SECURITY_DETECTION_ORGANIZATION_ID=corp-example
MAGPIE_SECURITY_DETECTION_IP_HASH_SECRET=
MAGPIE_SECURITY_DETECTION_QUEUE_SIZE=128
MAGPIE_SECURITY_DETECTION_TIMEOUT_MS=3000
MAGPIE_SECURITY_DETECTION_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# M4 Audit Service
# ---------------------------------------------------------------------------
AUDIT_BIND=0.0.0.0
AUDIT_PORT=3455
AUDIT_STORE_PATH=/data/audit-store.json
AUDIT_TOKEN=replace-with-a-separate-long-random-audit-token

# ---------------------------------------------------------------------------
# M9 Employee Portal — port 3007
# ---------------------------------------------------------------------------
PORT=3007
EMPLOYEE_BIND=0.0.0.0
EMPLOYEE_PUBLIC_URL=https://portal.ai.corp.example
EMPLOYEE_SESSION_SECRET=replace-with-a-separate-long-random-employee-session-secret
EMPLOYEE_SECURE_COOKIE=true
EMPLOYEE_SESSION_TTL_HOURS=8
EMPLOYEE_RATE_LIMIT_PER_MINUTE=120
EMPLOYEE_STORE_PATH=/data/portal-store.json
EMPLOYEE_DEFAULT_ORG_UNIT=

# Model catalog URL served by admin-service (recommended)
ADMIN_MODEL_CATALOG_URL=http://admin:3445/api/v1/admin/models
ADMIN_MODEL_CATALOG_TOKEN=replace-with-a-separate-long-random-model-catalog-token

# Usage service URL served by admin-service
USAGE_SERVICE_URL=http://admin:3445/api/v1/admin/usage/summary
USAGE_SERVICE_TOKEN=replace-with-a-separate-long-random-usage-service-token

# ---------------------------------------------------------------------------
# M10 MCP Resource Library (mcp-gateway) — port 3006
# ---------------------------------------------------------------------------
MCP_GATEWAY_BIND=0.0.0.0
MCP_GATEWAY_PORT=3006
MCP_GATEWAY_STORE_PATH=/data/mcp-gateway-store.json
MCP_GATEWAY_SERVICE_TOKEN=replace-with-a-separate-long-random-mcp-gateway-token
MCP_GATEWAY_AUDIT_PATH=/data/mcp-call-audit.jsonl

# ---------------------------------------------------------------------------
# M11 Deployment & Operations
# ---------------------------------------------------------------------------
# Reverse proxy (Nginx)
NGINX_HOST_PORT=80
NGINX_SSL_PORT=443
NGINX_SSL_CERT_PATH=./nginx/certs/server.crt
NGINX_SSL_KEY_PATH=./nginx/certs/server.key

# Postgres
POSTGRES_HOST_PORT=5432
POSTGRES_USER=magpie
POSTGRES_PASSWORD=replace-with-a-separate-long-random-postgres-password
POSTGRES_DB=magpie_enterprise

# Redis
REDIS_HOST_PORT=6379
REDIS_PASSWORD=replace-with-a-separate-long-random-redis-password

# Prometheus
PROMETHEUS_HOST_PORT=9090

# Grafana
GRAFANA_HOST_PORT=3008
GRAFANA_ADMIN_PASSWORD=replace-with-a-separate-long-random-grafana-admin-password

# Public URLs (registered with OIDC IdP as redirect URIs)
EMPLOYEE_PUBLIC_URL=https://portal.ai.corp.example
ADMIN_PUBLIC_URL=https://admin.ai.corp.example
AUTH_PUBLIC_URL=https://auth.ai.corp.example

# ---------------------------------------------------------------------------
# Secret generation examples (PowerShell)
# ---------------------------------------------------------------------------
# [System.Web.Security.Membership]::GeneratePassword(32, 8)
# or:  [Convert]::ToBase64String(([System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes(32)))
