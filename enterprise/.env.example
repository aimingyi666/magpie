# Host interface and port the gateway publishes. Bind to the internal
# interface (or keep 0.0.0.0 and restrict it with the host firewall).
MAGPIE_BIND=0.0.0.0
MAGPIE_PORT=3425

# Only these source networks may reach the gateway. Loopback is always allowed.
# Put your VPN / office ranges here, never 0.0.0.0/0 on a public host.
MAGPIE_ALLOW_IPS=10.0.0.0/8,192.168.0.0/16

# Use your own built image when you need fork-specific changes:
#   docker build -t registry.internal/magpie:1.0 .
#   MAGPIE_IMAGE=registry.internal/magpie:1.0
MAGPIE_IMAGE=ghcr.io/yetone/magpie:stable

# Point clients at your internal update feed (optional).
# MAGPIE_UPDATE_FEED=https://update.internal.example/magpie/feed.json

# ---------------------------------------------------------------------------
# Optional gateway-control adapter. Start it with:
#   docker compose --profile gateway-control up -d
#
# It has no published host port and must only be reachable on the internal
# Compose network. Generate this token independently from every other secret.
# It must be at least 32 characters; the service fails closed when empty.
# The auth profile starts this service automatically and uses the same token.
# ---------------------------------------------------------------------------
GATEWAY_CONTROL_URL=http://gateway-control:3446
GATEWAY_CONTROL_TOKEN=replace-with-a-separate-long-random-gateway-control-token
GATEWAY_CONTROL_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Optional OIDC/device service. This profile also starts gateway-control:
#   docker compose --profile auth up -d
# ---------------------------------------------------------------------------
AUTH_BIND=0.0.0.0
AUTH_HOST_PORT=3444
AUTH_PUBLIC_URL=https://auth.ai.corp.example
AUTH_SECURE_COOKIE=true
AUTH_SESSION_TTL_HOURS=12
AUTH_DEVICE_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=120
AUTH_ALLOWED_RETURN_ORIGINS=

# M3-C device sync credential. The device exchanges its opaque device token
# for a short-lived, single-purpose sync credential at
#   POST /api/v1/devices/sync-credential
# Generate this independently from every other secret. It must be at least 32
# characters and the service refuses to start when it is empty or too short.
SYNC_TOKEN_SECRET=replace-with-a-separate-long-random-sync-token-secret
# Lifetime of one sync credential, in seconds. Allowed range is 60-900.
SYNC_TOKEN_TTL_SECONDS=300
# The audience the credential is bound to. The resource service must use the
# same value, otherwise it rejects the credential as invalid_sync_token.
SYNC_TOKEN_AUDIENCE=magpie-enterprise-resource

# Generate these independently. Never reuse the gateway issuer key as the
# admin token or cookie secret.
AUTH_COOKIE_SECRET=replace-with-a-separate-long-random-cookie-secret
AUTH_ADMIN_TOKEN=replace-with-a-separate-long-random-admin-token
# Used only by admin-service to call auth-service on the internal network.
# It must differ from AUTH_ADMIN_TOKEN and must never reach a browser.
AUTH_INTERNAL_ADMIN_TOKEN=replace-with-a-separate-long-random-service-token

OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
OIDC_CLIENT_ID=magpie-enterprise
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
OIDC_REDIRECT_URI=https://auth.ai.corp.example/oauth/callback
OIDC_SCOPES=openid profile email
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
OIDC_ALLOWED_EMAIL_DOMAINS=corp.example
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name

# Public URL employees reach. The auth container calls the gateway over the
# Compose network; employees receive this public URL.
MAGPIE_GATEWAY_PUBLIC_URL=https://ai.corp.example
MAGPIE_ISSUER_KEY=replace-with-the-issuer-key-created-on-the-gateway
MAGPIE_KEY_TTL=8h
MAGPIE_KEY_MODELS=deepseek/deepseek-chat
MAGPIE_KEY_TOKENS=0
MAGPIE_KEY_COST=0

# ---------------------------------------------------------------------------
# Optional management console. This starts gateway + gateway-control + auth +
# admin with:
#   docker compose --profile admin up -d
#
# Register ADMIN_OIDC_REDIRECT_URI with the IdP separately from the employee
# auth callback. Use a dedicated OIDC client and require MFA/conditional access.
# ---------------------------------------------------------------------------
ADMIN_BIND=0.0.0.0
ADMIN_HOST_PORT=3445
ADMIN_PUBLIC_URL=https://admin.ai.corp.example
ADMIN_SECURE_COOKIE=true
ADMIN_SESSION_TTL_HOURS=8
ADMIN_IDLE_TIMEOUT_MINUTES=30
ADMIN_RATE_LIMIT_PER_MINUTE=120
# Keep this to the office/VPN or a dedicated management network.
ADMIN_ALLOWED_IPS=10.0.0.0/8,192.168.0.0/16

# Generate independently from every other secret.
ADMIN_SESSION_SECRET=replace-with-a-separate-long-random-admin-session-secret

# Temporary bootstrap only. Prefer stable OIDC subject ids; remove these after
# formal role bindings are seeded. The resulting super_admin binding expires.
ADMIN_BOOTSTRAP_SUBJECTS=
ADMIN_BOOTSTRAP_EMAILS=platform-admin@corp.example
ADMIN_BOOTSTRAP_VALID_HOURS=24

# Use a dedicated management OIDC application, not the employee login app.
ADMIN_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
ADMIN_OIDC_CLIENT_ID=magpie-enterprise-admin
ADMIN_OIDC_CLIENT_SECRET=replace-with-admin-oidc-client-secret
ADMIN_OIDC_REDIRECT_URI=https://admin.ai.corp.example/admin/oauth/callback
ADMIN_OIDC_SCOPES=openid profile email
ADMIN_OIDC_TOKEN_AUTH_METHOD=client_secret_basic
ADMIN_ALLOWED_EMAIL_DOMAINS=corp.example
ADMIN_EMAIL_CLAIM=email
ADMIN_NAME_CLAIM=name
ADMIN_REQUIRE_MFA=true
# Keep true unless the IdP cannot emit email_verified and the tenant claim is
# trusted through another control. Document that exception during deployment.
ADMIN_REQUIRE_VERIFIED_EMAIL=true
# Optional: pin the IdP authentication context, for example a phishing-resistant ACR.
# The service sends this value as the OIDC acr_values request parameter.
ADMIN_ALLOWED_ACR_VALUES=

# APR-01c step-up for high-risk and critical management writes. Register
# ADMIN_STEP_UP_REDIRECT_URI as a separate OIDC application. Configure all
# three client values together; when omitted, risk H/C writes fail closed with
# step_up_unavailable. The step-up client must differ from the login client.
ADMIN_STEP_UP_OIDC_CLIENT_ID=
ADMIN_STEP_UP_OIDC_CLIENT_SECRET=
ADMIN_STEP_UP_REDIRECT_URI=https://admin.ai.corp.example/admin/oauth/step-up/callback
ADMIN_STEP_UP_OIDC_SCOPES=openid profile email
# Leave empty to require a strong amr or an acr containing "mfa". When set,
# only these ACR values are accepted and requested as essential claims.
ADMIN_STEP_UP_ALLOWED_ACR_VALUES=
ADMIN_STEP_UP_TTL_SECONDS=600
ADMIN_STEP_UP_CRITICAL_TTL_SECONDS=300
ADMIN_STEP_UP_AUTH_TIME_MAX_AGE_SECONDS=120
ADMIN_AUTH_SERVICE_TIMEOUT_MS=5000

# APR-01b external approval callback adapter. Leave all three trust values
# empty to disable the integration endpoint. When enabled, the secret must be
# at least 32 characters and delivered to the external approval system out of
# band. The signature input is
# "<timestamp>.<nonce>.<raw-json-body>" using HMAC-SHA256.
ADMIN_APPROVAL_CALLBACK_SECRET=
ADMIN_APPROVAL_CALLBACK_ISSUER=
ADMIN_APPROVAL_CALLBACK_AUDIENCE=
ADMIN_APPROVAL_CALLBACK_MAX_SKEW_SECONDS=300
ADMIN_APPROVAL_CALLBACK_NONCE_TTL_SECONDS=600

# NOTIFY transactional outbox. These settings control lease recovery, retry
# bounds and polling. External notifications stay disabled until both the
# channel flag is true and at least one enabled channel is configured.
ADMIN_NOTIFICATION_OUTBOX_POLL_SECONDS=30
ADMIN_NOTIFICATION_ESCALATION_POLL_SECONDS=30
ADMIN_NOTIFICATION_OUTBOX_LEASE_SECONDS=60
ADMIN_NOTIFICATION_OUTBOX_MAX_ATTEMPTS=6
ADMIN_NOTIFICATION_OUTBOX_BATCH_SIZE=20

# NOTIFY-01b channel transports. An empty outbound allowlist intentionally
# denies every direct endpoint. Use exact hostnames or a single leading "*."
# wildcard, for example "hooks.example.com,*.webhook.example.com". Endpoint
# references are resolved from environment variables at delivery time.
ADMIN_NOTIFICATION_CHANNELS_ENABLED=false
ADMIN_NOTIFICATION_OUTBOUND_ALLOWLIST=
ADMIN_NOTIFICATION_EMAIL_RECIPIENT_DOMAINS=
ADMIN_NOTIFICATION_HTTP_TIMEOUT_MS=5000
ADMIN_NOTIFICATION_HTTP_MAX_RESPONSE_BYTES=65536
ADMIN_NOTIFICATION_HTTP_MAX_REDIRECTS=3

# Secret values must be injected by the deployment secret manager. Channels
# store only the environment variable name in secretRef; never put the value
# in the admin store, API request, compose file or source control.
MAGPIE_NOTIFICATION_WEBHOOK_SECRET=
MAGPIE_NOTIFICATION_IM_TOKEN=
MAGPIE_NOTIFICATION_EMAIL_GATEWAY_TOKEN=
MAGPIE_NOTIFICATION_TICKETING_TOKEN=

# M2-B read-only governance. The admin service mounts the gateway data volume
# read-only and never writes to it. The model list contains stable model IDs
# already exposed by the enterprise gateway.
ADMIN_MODELS=deepseek/deepseek-chat

# C4-03a formal model catalog. Copy model-catalog.example.json to
# model-catalog.json on the host before starting the admin profile. The file is
# mounted read-only and the service fails closed when it is missing or invalid.
# Optionally pin the exact bytes by setting the SHA-256 digest; use
# `sha256sum model-catalog.json` and prefix the result with `sha256:`.
ADMIN_MODEL_CATALOG_DIGEST=

ADMIN_USAGE_PATH=/magpie-readonly/magpie/usage.jsonl
ADMIN_USAGE_MAX_BYTES=268435456
ADMIN_USAGE_MAX_LINE_BYTES=1048576
ADMIN_USAGE_MAX_RECORDS=1000000
ADMIN_USAGE_MAX_FIELDS=256
ADMIN_USAGE_MAX_RANGE_DAYS=366

# ---------------------------------------------------------------------------
# M3-A resource catalog and M3-C client sync control plane. This profile is
# internal-only. The admin console now has read-only catalog and sync-report
# visibility. Resource publish/rollback UI and approval integration are not
# implemented yet, so the admin and resource profiles must both run together:
#   docker compose --profile resource up -d resource
#
# The signing key must be an Ed25519 private key generated outside this file:
#   node enterprise/resource-service/scripts/generate-signing-key.mjs \
#     enterprise/secrets/resource-signing-key.pem
# Never put the private key material in .env or source control.
# ---------------------------------------------------------------------------
RESOURCE_UID=10001
RESOURCE_GID=10001
RESOURCE_SIGNING_KEY_FILE=./secrets/resource-signing-key.pem
RESOURCE_SIGNING_KEY_ID=resource-2026-11-v1
RESOURCE_SERVICE_TOKEN=replace-with-a-separate-long-random-resource-service-token
RESOURCE_STORE_PATH=/data/resource-store.json
RESOURCE_CONTENT_PATH=/content/objects
RESOURCE_MAX_CONTENT_BYTES=1048576
RESOURCE_MAX_RESOURCES=1000
RESOURCE_MAX_RELEASES_PER_RESOURCE=200
RESOURCE_RATE_LIMIT_PER_MINUTE=600

# The resource service verifies the device sync credential issued by
# auth-service. RESOURCE_SYNC_TOKEN_SECRET MUST hold the same value as
# SYNC_TOKEN_SECRET above, but it must differ from RESOURCE_SERVICE_TOKEN and
# from every other secret in this file. Generate one value and reuse it in
# these two variables only:
#   openssl rand -hex 32
RESOURCE_SYNC_TOKEN_SECRET=replace-with-the-same-value-as-SYNC_TOKEN_SECRET
RESOURCE_SYNC_TOKEN_AUDIENCE=magpie-enterprise-resource
# Where the latest per-device sync report is stored. It never holds resource
# content, credentials or free text.
RESOURCE_SYNC_REPORT_PATH=/data/sync-reports.json
# Limits on the desired-state snapshot handed to one employee device.
RESOURCE_MAX_SNAPSHOT_BYTES=8388608
RESOURCE_MAX_SNAPSHOT_RESOURCES=200
# Limit on one device sync report body.
RESOURCE_MAX_SYNC_REPORT_BYTES=262144

# The admin service reads the resource service over the internal network. Set
# both variables together or leave both empty; a half-configured pair stops
# admin-service at startup. The token must equal RESOURCE_SERVICE_TOKEN and
# must differ from SYNC_TOKEN_SECRET and every other secret in this file.
# ADMIN_RESOURCE_SERVICE_URL must not be written into docker-compose.yml as a
# default; point it at the resource service explicitly.
ADMIN_RESOURCE_SERVICE_URL=http://resource:3447
ADMIN_RESOURCE_SERVICE_TOKEN=replace-with-the-same-value-as-RESOURCE_SERVICE_TOKEN
ADMIN_RESOURCE_SERVICE_TIMEOUT_MS=5000
ADMIN_RESOURCE_SERVICE_MAX_RESPONSE_BYTES=4194304

# ---------------------------------------------------------------------------
# M3-B remote MCP governance core. This profile is internal-only and is not
# yet wired into admin-service approval, the management console or client
# synchronization:
#   docker compose --profile mcp-gateway up -d mcp-gateway
#
# MCP_SERVICE_TOKEN and MCP_APPROVAL_HMAC_SECRET must be generated separately
# from every other service/admin/OIDC/upstream credential. The service rejects
# a short service token at startup. An empty approval secret makes high/critical
# calls fail closed. MCP_UPSTREAM_ALLOWED_HOSTS must be non-empty before any
# upstream endpoint can be registered.
# ---------------------------------------------------------------------------
MCP_UID=10002
MCP_GID=10002
MCP_PUBLIC_URL=https://mcp.ai.corp.example
MCP_SERVICE_TOKEN=replace-with-a-separate-long-random-mcp-service-token
MCP_APPROVAL_HMAC_SECRET=replace-with-a-separate-long-random-approval-hmac-secret
MCP_STORE_PATH=/data/mcp-registry.json
MCP_AUDIT_PATH=/data/mcp-audit.jsonl
MCP_UPSTREAM_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_ALLOW_HTTP_UPSTREAMS=false
MCP_ALLOW_PRIVATE_UPSTREAMS=false

# Set only when the container also receives the CA file through a reviewed
# read-only mount. Do not point at a host path that is not mounted.
MCP_UPSTREAM_CA_PATH=
MCP_MAX_BODY_BYTES=262144
MCP_MAX_SERVERS=500
MCP_MAX_CLIENTS=10000
MCP_MAX_TOOLS_PER_SERVER=500
MCP_CATALOG_TTL_MS=60000
MCP_UPSTREAM_TIMEOUT_MS=10000
MCP_UPSTREAM_MAX_RESPONSE_BYTES=1048576
MCP_HEALTH_INTERVAL_MS=30000
MCP_HEALTH_TIMEOUT_MS=5000
MCP_BREAKER_FAILURE_THRESHOLD=3
MCP_BREAKER_COOLDOWN_MS=30000
MCP_RATE_LIMIT_PER_MINUTE=600
MCP_AUTH_RATE_LIMIT_PER_MINUTE=60
MCP_CLIENT_TOKEN_TTL_DAYS=30
MCP_APPROVAL_MAX_TTL_SECONDS=900

# Upstream credentials are not configured here. Register only an environment
# variable name such as MCP_SEARCH_UPSTREAM_TOKEN, then inject its value through
# the deployment secret manager. Never place the value in .env, Compose or the
# registry.

# ---------------------------------------------------------------------------
# M4-A/M4-B/M4-C/M4-D/M4-E audit core. This profile is internal-only and does not
# publish a host port:
#   docker compose --profile admin --profile audit up -d
#
# The service token must be generated independently from every other secret.
# It protects event ingest only. Content metadata/body routes use the separate
# administrator token below; production must place them behind admin-service
# OIDC/RBAC/step-up and organization-scope checks. M4-E connects that trusted
# path to the admin UI and adds an outer encrypted export layer.
# ---------------------------------------------------------------------------
AUDIT_UID=10003
AUDIT_GID=10003
AUDIT_BIND=0.0.0.0
AUDIT_PORT=3449
AUDIT_SERVICE_TOKEN=replace-with-a-separate-long-random-audit-service-token
AUDIT_STORE_PATH=/data/audit-store.json
AUDIT_MAX_BODY_BYTES=32768
AUDIT_MAX_EVENTS=1000000
AUDIT_MAX_QUEUE_EVENTS=100000
AUDIT_MAX_SESSIONS=100000
AUDIT_FLUSH_INTERVAL_MS=1000
AUDIT_BATCH_SIZE=200
AUDIT_RATE_LIMIT_PER_MINUTE=6000

# M4-B/M4-C content audit core is disabled by default and accepts only L2
# redacted text. Content administration has its own default-off gate and
# requires four independent secrets plus a trusted organization id. The old
# AUDIT_CONTENT_READ_TOKEN static body-read bypass is retired and causes startup
# to fail if set.
AUDIT_CONTENT_ENABLED=false
# Set AUDIT_CONTENT_ENCRYPTION_KEY in the deployment secret manager as a
# random 32-byte key encoded as base64 or 64 hex characters.
AUDIT_CONTENT_ENCRYPTION_KEY=
AUDIT_CONTENT_ADMIN_ENABLED=false
AUDIT_CONTENT_ADMIN_TOKEN=replace-with-a-separate-long-random-content-admin-token
AUDIT_CONTENT_ORGANIZATION_ID=corp-example
AUDIT_CONTENT_GRANT_SECRET=replace-with-a-separate-long-random-content-grant-secret
AUDIT_CONTENT_CURSOR_SECRET=replace-with-a-separate-long-random-content-cursor-secret
# One-time body grant TTL. Allowed range is 15-300 seconds; the service-side
# value is the hard ceiling and request callers cannot extend it.
AUDIT_CONTENT_GRANT_TTL_SECONDS=120
AUDIT_CONTENT_STORE_DIR=/data/audit-content
AUDIT_CONTENT_MAX_BODY_BYTES=393216
AUDIT_CONTENT_MAX_CHUNK_BYTES=262144
AUDIT_CONTENT_MAX_STREAM_BYTES=1048576
AUDIT_CONTENT_MAX_BUFFER_BYTES=67108864
AUDIT_CONTENT_MAX_ACTIVE_STREAMS=256
AUDIT_CONTENT_STREAM_TTL_MS=900000

# M4-D governance is disabled by default. Enabling it requires the M4-C
# content-admin gate plus separate governance/proof secrets. Export packages
# require a second independent 32-byte encryption key. Never reuse any token or
# key listed in this file.
AUDIT_CONTENT_GOVERNANCE_ENABLED=false
AUDIT_CONTENT_GOVERNANCE_TOKEN=replace-with-a-separate-long-random-content-governance-token
AUDIT_CONTENT_PROOF_SECRET=replace-with-a-separate-long-random-content-proof-secret
AUDIT_CONTENT_EXPORT_ENABLED=false
AUDIT_CONTENT_EXPORT_SECRET=replace-with-a-separate-long-random-content-export-secret
# Set AUDIT_CONTENT_EXPORT_KEY in the deployment secret manager as a second
# random 32-byte key encoded as base64 or 64 hex characters.
AUDIT_CONTENT_EXPORT_KEY=
AUDIT_CONTENT_EXPORT_TTL_SECONDS=120
AUDIT_CONTENT_RETENTION_SWEEP_INTERVAL_MS=3600000

# M4-E admin-service content governance is disabled by default because the
# five settings below must be configured as a group. When enabled, start both
# profiles: docker compose --profile admin --profile audit up -d.
#
# The two tokens are different, at least 32 characters, and must match the
# audit-service values:
#   ADMIN_AUDIT_CONTENT_SERVICE_ADMIN_TOKEN == AUDIT_CONTENT_ADMIN_TOKEN
#   ADMIN_AUDIT_CONTENT_SERVICE_GOVERNANCE_TOKEN == AUDIT_CONTENT_GOVERNANCE_TOKEN
#   ADMIN_AUDIT_CONTENT_SERVICE_ORGANIZATION_ID == AUDIT_CONTENT_ORGANIZATION_ID
#
# ADMIN_AUDIT_CONTENT_EXPORT_KEY is a separate 32-byte base64/hex key used by
# admin-service for its outer AES-256-GCM layer. It must not be reused from
# AUDIT_CONTENT_EXPORT_KEY, OIDC, service tokens or any other secret. Production
# deployments must inject all values from KMS/Secret Manager, never source or
# commit them. Real Docker/Compose, KMS and production acceptance are pending.
ADMIN_AUDIT_CONTENT_SERVICE_URL=http://audit:3449
ADMIN_AUDIT_CONTENT_SERVICE_ADMIN_TOKEN=
ADMIN_AUDIT_CONTENT_SERVICE_GOVERNANCE_TOKEN=
ADMIN_AUDIT_CONTENT_SERVICE_ORGANIZATION_ID=
ADMIN_AUDIT_CONTENT_EXPORT_KEY=
ADMIN_AUDIT_CONTENT_SERVICE_TIMEOUT_MS=5000
ADMIN_AUDIT_CONTENT_SERVICE_MAX_RESPONSE_BYTES=4194304
ADMIN_AUDIT_CONTENT_SERVICE_MAX_EXPORT_BYTES=33554432
