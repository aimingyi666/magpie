# Host interface and port the gateway publishes. Bind to the internal
# interface (or keep 0.0.0.0 and restrict it with the host firewall).
MAGPIE_BIND=0.0.0.0
MAGPIE_PORT=3425

# Only these source networks may reach the gateway. Loopback is always allowed.
# Put your VPN / office ranges here, never 0.0.0.0/0 on a public host.
MAGPIE_ALLOW_IPS=10.0.0.0/8,192.168.0.0/16

# Use your own built image when you need fork-specific changes:
#   docker build -t registry.internal/magpie:1.0 .
#   MAGPIE_IMAGE=registry.internal/magpie:1.0
MAGPIE_IMAGE=ghcr.io/yetone/magpie:stable

# Point clients at your internal update feed (optional).
# MAGPIE_UPDATE_FEED=https://update.internal.example/magpie/feed.json

# ---------------------------------------------------------------------------
# Optional gateway-control adapter. Start it with:
#   docker compose --profile gateway-control up -d
#
# It has no published host port and must only be reachable on the internal
# Compose network. Generate this token independently from every other secret.
# It must be at least 32 characters; the service fails closed when empty.
# The auth profile starts this service automatically and uses the same token.
# ---------------------------------------------------------------------------
GATEWAY_CONTROL_URL=http://gateway-control:3446
GATEWAY_CONTROL_TOKEN=replace-with-a-separate-long-random-gateway-control-token
GATEWAY_CONTROL_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Optional OIDC/device service. This profile also starts gateway-control:
#   docker compose --profile auth up -d
# ---------------------------------------------------------------------------
AUTH_BIND=0.0.0.0
AUTH_HOST_PORT=3444
AUTH_PUBLIC_URL=https://auth.ai.corp.example
AUTH_SECURE_COOKIE=true
AUTH_SESSION_TTL_HOURS=12
AUTH_DEVICE_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=120
AUTH_ALLOWED_RETURN_ORIGINS=

# Generate these independently. Never reuse the gateway issuer key as the
# admin token or cookie secret.
AUTH_COOKIE_SECRET=replace-with-a-separate-long-random-cookie-secret
AUTH_ADMIN_TOKEN=replace-with-a-separate-long-random-admin-token
# Used only by admin-service to call auth-service on the internal network.
# It must differ from AUTH_ADMIN_TOKEN and must never reach a browser.
AUTH_INTERNAL_ADMIN_TOKEN=replace-with-a-separate-long-random-service-token

OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
OIDC_CLIENT_ID=magpie-enterprise
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
OIDC_REDIRECT_URI=https://auth.ai.corp.example/oauth/callback
OIDC_SCOPES=openid profile email
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
OIDC_ALLOWED_EMAIL_DOMAINS=corp.example
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name

# Public URL employees reach. The auth container calls the gateway over the
# Compose network; employees receive this public URL.
MAGPIE_GATEWAY_PUBLIC_URL=https://ai.corp.example
MAGPIE_ISSUER_KEY=replace-with-the-issuer-key-created-on-the-gateway
MAGPIE_KEY_TTL=8h
MAGPIE_KEY_MODELS=deepseek/deepseek-chat
MAGPIE_KEY_TOKENS=0
MAGPIE_KEY_COST=0

# ---------------------------------------------------------------------------
# Optional management console. This starts gateway + gateway-control + auth +
# admin with:
#   docker compose --profile admin up -d
#
# Register ADMIN_OIDC_REDIRECT_URI with the IdP separately from the employee
# auth callback. Use a dedicated OIDC client and require MFA/conditional access.
# ---------------------------------------------------------------------------
ADMIN_BIND=0.0.0.0
ADMIN_HOST_PORT=3445
ADMIN_PUBLIC_URL=https://admin.ai.corp.example
ADMIN_SECURE_COOKIE=true
ADMIN_SESSION_TTL_HOURS=8
ADMIN_IDLE_TIMEOUT_MINUTES=30
ADMIN_RATE_LIMIT_PER_MINUTE=120
# Keep this to the office/VPN or a dedicated management network.
ADMIN_ALLOWED_IPS=10.0.0.0/8,192.168.0.0/16

# Generate independently from every other secret.
ADMIN_SESSION_SECRET=replace-with-a-separate-long-random-admin-session-secret

# Temporary bootstrap only. Prefer stable OIDC subject ids; remove these after
# formal role bindings are seeded. The resulting super_admin binding expires.
ADMIN_BOOTSTRAP_SUBJECTS=
ADMIN_BOOTSTRAP_EMAILS=platform-admin@corp.example
ADMIN_BOOTSTRAP_VALID_HOURS=24

# Use a dedicated management OIDC application, not the employee login app.
ADMIN_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
ADMIN_OIDC_CLIENT_ID=magpie-enterprise-admin
ADMIN_OIDC_CLIENT_SECRET=replace-with-admin-oidc-client-secret
ADMIN_OIDC_REDIRECT_URI=https://admin.ai.corp.example/admin/oauth/callback
ADMIN_OIDC_SCOPES=openid profile email
ADMIN_OIDC_TOKEN_AUTH_METHOD=client_secret_basic
ADMIN_ALLOWED_EMAIL_DOMAINS=corp.example
ADMIN_EMAIL_CLAIM=email
ADMIN_NAME_CLAIM=name
ADMIN_REQUIRE_MFA=true
# Keep true unless the IdP cannot emit email_verified and the tenant claim is
# trusted through another control. Document that exception during deployment.
ADMIN_REQUIRE_VERIFIED_EMAIL=true
# Optional: pin the IdP authentication context, for example a phishing-resistant ACR.
# The service sends this value as the OIDC acr_values request parameter.
ADMIN_ALLOWED_ACR_VALUES=

# APR-01c step-up for high-risk and critical management writes. Register
# ADMIN_STEP_UP_REDIRECT_URI as a separate OIDC application. Configure all
# three client values together; when omitted, risk H/C writes fail closed with
# step_up_unavailable. The step-up client must differ from the login client.
ADMIN_STEP_UP_OIDC_CLIENT_ID=
ADMIN_STEP_UP_OIDC_CLIENT_SECRET=
ADMIN_STEP_UP_REDIRECT_URI=https://admin.ai.corp.example/admin/oauth/step-up/callback
ADMIN_STEP_UP_OIDC_SCOPES=openid profile email
# Leave empty to require a strong amr or an acr containing "mfa". When set,
# only these ACR values are accepted and requested as essential claims.
ADMIN_STEP_UP_ALLOWED_ACR_VALUES=
ADMIN_STEP_UP_TTL_SECONDS=600
ADMIN_STEP_UP_CRITICAL_TTL_SECONDS=300
ADMIN_STEP_UP_AUTH_TIME_MAX_AGE_SECONDS=120
ADMIN_AUTH_SERVICE_TIMEOUT_MS=5000

# APR-01b external approval callback adapter. Leave all three trust values
# empty to disable the integration endpoint. When enabled, the secret must be
# at least 32 characters and delivered to the external approval system out of
# band. The signature input is
# "<timestamp>.<nonce>.<raw-json-body>" using HMAC-SHA256.
ADMIN_APPROVAL_CALLBACK_SECRET=
ADMIN_APPROVAL_CALLBACK_ISSUER=
ADMIN_APPROVAL_CALLBACK_AUDIENCE=
ADMIN_APPROVAL_CALLBACK_MAX_SKEW_SECONDS=300
ADMIN_APPROVAL_CALLBACK_NONCE_TTL_SECONDS=600

# NOTIFY transactional outbox. These settings control lease recovery, retry
# bounds and polling. External notifications stay disabled until both the
# channel flag is true and at least one enabled channel is configured.
ADMIN_NOTIFICATION_OUTBOX_POLL_SECONDS=30
ADMIN_NOTIFICATION_ESCALATION_POLL_SECONDS=30
ADMIN_NOTIFICATION_OUTBOX_LEASE_SECONDS=60
ADMIN_NOTIFICATION_OUTBOX_MAX_ATTEMPTS=6
ADMIN_NOTIFICATION_OUTBOX_BATCH_SIZE=20

# NOTIFY-01b channel transports. An empty outbound allowlist intentionally
# denies every direct endpoint. Use exact hostnames or a single leading "*."
# wildcard, for example "hooks.example.com,*.webhook.example.com". Endpoint
# references are resolved from environment variables at delivery time.
ADMIN_NOTIFICATION_CHANNELS_ENABLED=false
ADMIN_NOTIFICATION_OUTBOUND_ALLOWLIST=
ADMIN_NOTIFICATION_EMAIL_RECIPIENT_DOMAINS=
ADMIN_NOTIFICATION_HTTP_TIMEOUT_MS=5000
ADMIN_NOTIFICATION_HTTP_MAX_RESPONSE_BYTES=65536
ADMIN_NOTIFICATION_HTTP_MAX_REDIRECTS=3

# Secret values must be injected by the deployment secret manager. Channels
# store only the environment variable name in secretRef; never put the value
# in the admin store, API request, compose file or source control.
MAGPIE_NOTIFICATION_WEBHOOK_SECRET=
MAGPIE_NOTIFICATION_IM_TOKEN=
MAGPIE_NOTIFICATION_EMAIL_GATEWAY_TOKEN=
MAGPIE_NOTIFICATION_TICKETING_TOKEN=

# M2-B read-only governance. The admin service mounts the gateway data volume
# read-only and never writes to it. The model list contains stable model IDs
# already exposed by the enterprise gateway.
ADMIN_MODELS=deepseek/deepseek-chat

# C4-03a formal model catalog. Copy model-catalog.example.json to
# model-catalog.json on the host before starting the admin profile. The file is
# mounted read-only and the service fails closed when it is missing or invalid.
# Optionally pin the exact bytes by setting the SHA-256 digest; use
# `sha256sum model-catalog.json` and prefix the result with `sha256:`.
ADMIN_MODEL_CATALOG_DIGEST=

ADMIN_USAGE_PATH=/magpie-readonly/magpie/usage.jsonl
ADMIN_USAGE_MAX_BYTES=268435456
ADMIN_USAGE_MAX_LINE_BYTES=1048576
ADMIN_USAGE_MAX_RECORDS=1000000
ADMIN_USAGE_MAX_FIELDS=256
ADMIN_USAGE_MAX_RANGE_DAYS=366

# ---------------------------------------------------------------------------
# M3-A resource catalog. This profile is internal-only and is not yet
# integrated with admin-service approval or client synchronization:
#   docker compose --profile resource up -d resource
#
# The signing key must be an Ed25519 private key generated outside this file:
#   node enterprise/resource-service/scripts/generate-signing-key.mjs \
#     enterprise/secrets/resource-signing-key.pem
# Never put the private key material in .env or source control.
# ---------------------------------------------------------------------------
RESOURCE_UID=10001
RESOURCE_GID=10001
RESOURCE_SIGNING_KEY_FILE=./secrets/resource-signing-key.pem
RESOURCE_SIGNING_KEY_ID=resource-2026-11-v1
RESOURCE_SERVICE_TOKEN=replace-with-a-separate-long-random-resource-service-token
RESOURCE_STORE_PATH=/data/resource-store.json
RESOURCE_CONTENT_PATH=/content/objects
RESOURCE_MAX_CONTENT_BYTES=1048576
RESOURCE_MAX_RESOURCES=1000
RESOURCE_MAX_RELEASES_PER_RESOURCE=200
RESOURCE_RATE_LIMIT_PER_MINUTE=600
