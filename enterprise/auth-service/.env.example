# Public address employees use for browser login. No trailing slash.
AUTH_PUBLIC_URL=https://auth.ai.corp.example
AUTH_PORT=3444
AUTH_BIND=0.0.0.0
AUTH_STORE_PATH=/data/auth-store.json

# At least 32 random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
AUTH_ADMIN_TOKEN=replace-with-a-separate-long-random-admin-token
AUTH_INTERNAL_ADMIN_TOKEN=replace-with-a-separate-long-random-service-token
AUTH_SECURE_COOKIE=true
AUTH_SESSION_TTL_HOURS=12

# Standard OIDC authorization-code flow with PKCE.
OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
OIDC_CLIENT_ID=magpie-enterprise
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URI=https://auth.ai.corp.example/oauth/callback
OIDC_SCOPES=openid profile email
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
OIDC_ALLOWED_EMAIL_DOMAINS=corp.example
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name

# Extra browser return origins. Loopback callbacks are always allowed.
# AUTH_ALLOWED_RETURN_ORIGINS=http://127.0.0.1:3443

# The Magpie gateway that issues short-lived child credentials.
MAGPIE_GATEWAY_URL=http://gateway:3425
MAGPIE_GATEWAY_PUBLIC_URL=https://ai.corp.example
MAGPIE_ISSUER_KEY=replace-with-a-key-created-by-provision-user-and-let-issue
MAGPIE_KEY_TTL=8h
MAGPIE_KEY_MODELS=deepseek/deepseek-chat
# MAGPIE_KEY_TOKENS=200000
# MAGPIE_KEY_COST=10

# Least-privilege policy adapter. The token must match gateway-control and
# must differ from MAGPIE_ISSUER_KEY and every admin token.
GATEWAY_CONTROL_URL=http://127.0.0.1:3446
GATEWAY_CONTROL_TOKEN=replace-with-a-separate-long-random-gateway-control-token
GATEWAY_CONTROL_TIMEOUT_MS=10000

# Device token lifetime and basic per-IP rate limiting.
AUTH_DEVICE_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=120
